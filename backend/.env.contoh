# Salin menjadi .env lalu isi. Berkas .env TIDAK pernah masuk repositori.
#
# DATABASE_URL boleh dikosongkan saat pengembangan. Bila kosong, aplikasi
# menyalakan PostgreSQL tersemat sendiri lewat backend/skrip/nyalakan_basisdata.py
# (lihat ADR-0009). Isi hanya untuk penempatan ke server sungguhan.
DATABASE_URL=

# Wajib diisi. Bangkitkan dengan: openssl rand -hex 32
RAHASIA_JWT=ganti_dengan_hasil__openssl_rand_hex_32

# Asal frontend yang diizinkan CORS. Tidak pernah "*".
ASAL_FRONTEND=http://localhost:5173

# "pengembangan" atau "produksi". Di produksi, /docs dan /openapi.json
# tidak disajikan. WAJIB disetel "produksi" saat penempatan.
LINGKUNGAN=pengembangan
